[
  {
    "type": "file_input",
    "action_id": "file_input_1",
    "filetypes": ["pdf", "png"],
    "max_files": 3
  },
  {
    "type": "rich_text_input",
    "action_id": "rich_text_input_1",
    "initial_value": {
      "type": "rich_text",
      "elements": [
        {
          "type": "rich_text_section",
          "elements": [{ "type": "text", "text": "hi" }]
        }
      ]
    },
    "dispatch_action_config": {
      "trigger_actions_on": ["on_enter_pressed"]
    },
    "focus_on_load": true,
    "placeholder": {
      "type": "plain_text",
      "text": "Type something"
    },
    "min_lines": 2,
    "max_lines": 10
  },
  {
    "type": "workflow_button",
    "text": {
      "type": "plain_text",
      "text": "Run"
    },
    "workflow": {
      "trigger": {
        "url": "https://slack.com/shortcuts/Ft0000000000/abc123",
        "customizable_input_parameters": [
          { "name": "input_a", "value": "value_a" }
        ]
      }
    },
    "action_id": "workflow_button_1",
    "style": "primary",
    "accessibility_label": "Run the workflow"
  }
]
